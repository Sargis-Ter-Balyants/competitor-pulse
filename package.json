{
  "name": "competitor-pulse",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run db:up && concurrently -n llm,api,web -c cyan,green,magenta \"npm run dev:llm\" \"npm run dev:server\" \"npm run dev:web\"",
    "dev:llm": "node mock-llm/server.mjs",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "npm run db:generate -w server",
    "test": "npm run db:up && npm test -w server",
    "typecheck": "tsc -p server --noEmit && tsc -p web --noEmit",
    "build": "npm run build -w web && npm run build -w server",
    "start": "npm start -w server"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
